# ──────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ──────────────────────────────────────────────
# MongoDB
# ──────────────────────────────────────────────
# Local:       mongodb://localhost:27017/ai-career-accelerator
# Production:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb://localhost:27017/ai-career-accelerator

# ──────────────────────────────────────────────
# Session
# ──────────────────────────────────────────────
# Generate a strong random secret for production:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change-this-to-a-strong-random-secret

# ──────────────────────────────────────────────
# CORS — Frontend origin (NO trailing slash)
# ──────────────────────────────────────────────
# Local:       http://localhost:5173
# Production:  https://ai-career-accelerator-bay.vercel.app
CORS_ORIGIN=http://localhost:5173
